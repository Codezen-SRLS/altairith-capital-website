---
import { mission, nn } from "../data/site";
---

<section id="mission" class="section mission" aria-labelledby="mission-title">
    <img class="mission__mark" src="/assets/emblem-light.png" alt="" width="600" height="667" loading="lazy" />
    <div class="wrap mission__inner">
        <div class="mission__head">
            <h2 id="mission-title" class="eyebrow">03 · Our Mission</h2>
            <p class="mission__statement">
                {mission.before}<span class="gold">{mission.highlight}</span>{mission.after}
            </p>
        </div>
        <ul class="mission__pillars" aria-label="Principles">
            {
                mission.pillars.map((name, i) => (
                    <li>
                        <span class="num">{nn(i)}</span>
                        <span class="mission__pillar">{name}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .mission {
        background: var(--navy-800);
        overflow: hidden;
    }
    .mission__mark {
        position: absolute;
        right: -6%;
        bottom: -18%;
        width: min(560px, 60vw);
        height: auto;
        opacity: 0.05;
        pointer-events: none;
    }
    .mission__inner {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: clamp(56px, 7vw, 96px);
    }
    .mission__head {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }
    .mission__statement {
        max-width: 1100px;
        font-size: clamp(30px, 4vw, 58px);
        line-height: 1.18;
        font-weight: 300;
    }
    .gold {
        color: var(--gold);
    }
    .mission__pillars {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
    }
    .mission__pillars li {
        background: var(--navy-800);
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        gap: 40px;
    }
    .mission__pillar {
        font-size: 18px;
        font-weight: 400;
        color: var(--paper);
    }
</style>

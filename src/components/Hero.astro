---
import { hero, site } from "../data/site";
---

<section id="top" class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
        <canvas id="hero-canvas"></canvas>
    </div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__copy">
        <p class="eyebrow" style="animation: rise 1s 0.2s both">{site.title}</p>
        <h1 id="hero-title" class="hero__title">
            <span style="animation: rise 1.2s 0.4s both">{hero.lines[0]}</span>
            <span class="gold" style="animation: rise 1.2s 0.65s both">{hero.lines[1]}</span>
        </h1>
        <p class="hero__intro" style="animation: rise 1.2s 0.9s both">{hero.intro}</p>
        <div class="hero__ctas" style="animation: rise 1.2s 1.1s both">
            <a href="#about" class="btn btn--primary">Explore <span aria-hidden="true">→</span></a>
            <a href="#contact" class="btn">Contact Us</a>
        </div>
    </div>

    <div class="hero__meta label" aria-hidden="true">
        <div class="hero__scroll">
            <span class="hero__drip"><span></span></span>
            <span>Scroll</span>
        </div>
        <div class="hero__coords">
            {
                hero.meta.map((m) => (
                    <span>
                        {m.split("α").map((part, i) => (i ? [<span class="greek">α</span>, part] : part))}
                    </span>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { initHero } from "../scripts/hero";
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
    if (canvas) initHero(canvas, "/assets/emblem.png");
</script>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 120px var(--gutter) 40px;
    }
    .hero__bg {
        position: absolute;
        inset: 0;
    }
    .hero__bg canvas {
        width: 100%;
        height: 100%;
    }
    .hero__veil {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(90deg, #000b33d9 0%, #000b3366 42%, #000b3300 64%),
            linear-gradient(0deg, #000b33 0%, #000b33b3 38%, #000b3300 62%);
    }
    .hero__copy {
        position: relative;
        max-width: 720px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }
    .hero__title {
        font-family: var(--font-display);
        font-size: var(--fs-display);
        line-height: 1.2;
        letter-spacing: 0.01em;
        text-transform: uppercase;
    }
    .hero__title span {
        display: block;
    }
    .gold {
        color: var(--gold);
    }
    .hero__intro {
        max-width: 520px;
        font-size: var(--fs-body);
        color: var(--mist);
    }
    .hero__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }
    .hero__meta {
        position: relative;
        margin-top: clamp(48px, 10vh, 110px);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        color: var(--muted);
        animation: fade 1.5s 1.6s both;
    }
    .hero__scroll {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .hero__drip {
        position: relative;
        width: 1px;
        height: 38px;
        background: rgb(244 242 238 / 0.15);
        overflow: hidden;
    }
    .hero__drip span {
        position: absolute;
        inset: 0;
        background: var(--gold);
        animation: drip 2.4s ease-in-out infinite;
    }
    .greek {
        text-transform: none;
    }
    .hero__coords {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }
</style>
